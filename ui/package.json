{
  "name": "skillforge-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "build:preview": "VITE_PREVIEW=1 npm run build",
    "test:preview": "playwright test -c playwright.preview.config.ts",
    "scan:public": "node scripts/scan-public.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "a11y": "node scripts/a11y-sweep.mjs",
    "typecheck:qa": "tsc -p e2e-preview/tsconfig.json",
    "qa:preview": "npm run build:preview && npm run scan:public && npm run check:csp && npm run test:preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "postprocessing": "6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
