# Variable NAMES only. Never put values in this file or in the repo.
# Token: stored at ~/.config/skillforge/telegram_token (mode 0600, dir 0700)
TELEGRAM_BOT_TOKEN=
# Allowed numeric Telegram user ids, comma separated.
# Stored at ~/.config/skillforge/telegram_allowed_ids (mode 0600)
TELEGRAM_ALLOWED_IDS=
# Optional, from the NemoClaw docs: DM only for the demo
# TELEGRAM_REQUIRE_MENTION=
# TELEGRAM_GROUP_POLICY=
# Sandbox name used by telegram-setup.sh (default skillforge)
# SANDBOX=
