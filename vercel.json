{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ui && npm ci",
  "buildCommand": "cd ui && VITE_PREVIEW=1 npm run build",
  "outputDirectory": "ui/dist",
  "rewrites": [
    {
      "source": "/((?!assets/|demo/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)sync'"
}
